        int $outcome = ($self'owner, $self'resolver, $self'treasury, $self'token, $self'tokenSymbol, $self'marketId, $self'marketTitle, $self'timeframeId, $self'timeframeSeconds, $self'thresholdBps, $self'referencePriceE9, $self'protocolFeeBps, $self'createdAt, $self'closeTime, $self'status, $self'resolvedAt, $self'finalPriceE9, $self'totalYes, $self'totalNo, $self'positions)~$TonForecastMarket$_fun_computeOutcome($msg'finalPriceE9);
        if (( (( (($outcome == 2)) ? (($self'totalYes == 0)) : (false) )) ? (true) : (( (($outcome == 3)) ? (($self'totalNo == 0)) : (false) )) )) {
            $outcome = 4;
        }
        $self'status = $outcome;
        $self'finalPriceE9 = $msg'finalPriceE9;
        $self'resolvedAt = (($msg'resolvedAt > 0) ? $msg'resolvedAt : $global_now());
        $TonForecastMarket$_contract_store(($self'owner, $self'resolver, $self'treasury, $self'token, $self'tokenSymbol, $self'marketId, $self'marketTitle, $self'timeframeId, $self'timeframeSeconds, $self'thresholdBps, $self'referencePriceE9, $self'protocolFeeBps, $self'createdAt, $self'closeTime, $self'status, $self'resolvedAt, $self'finalPriceE9, $self'totalYes, $self'totalNo, $self'positions));
        return ();
    }
    
    ;; Receive ClaimReward message
    if (op == 0x54464331) {
        var $msg = empty_tuple();
        throw_unless(40921, ($self'owner, $self'resolver, $self'treasury, $self'token, $self'tokenSymbol, $self'marketId, $self'marketTitle, $self'timeframeId, $self'timeframeSeconds, $self'thresholdBps, $self'referencePriceE9, $self'protocolFeeBps, $self'createdAt, $self'closeTime, $self'status, $self'resolvedAt, $self'finalPriceE9, $self'totalYes, $self'totalNo, $self'positions)~$TonForecastMarket$_fun_isResolved());
        int $positionKey = ($self'owner, $self'resolver, $self'treasury, $self'token, $self'tokenSymbol, $self'marketId, $self'marketTitle, $self'timeframeId, $self'timeframeSeconds, $self'thresholdBps, $self'referencePriceE9, $self'protocolFeeBps, $self'createdAt, $self'closeTime, $self'status, $self'resolvedAt, $self'finalPriceE9, $self'totalYes, $self'totalNo, $self'positions)~$TonForecastMarket$_fun_derivePositionKey(__tact_context_get_sender());
        tuple $position = $Position$_load_opt(__tact_dict_get_uint_cell($self'positions, 256, $positionKey));
        throw_unless(19900, (~ null?($position)));
        throw_unless(45634, (~ $Position$_get_claimed($Position$_not_null($position))));
        int $payout = ($self'owner, $self'resolver, $self'treasury, $self'token, $self'tokenSymbol, $self'marketId, $self'marketTitle, $self'timeframeId, $self'timeframeSeconds, $self'thresholdBps, $self'referencePriceE9, $self'protocolFeeBps, $self'createdAt, $self'closeTime, $self'status, $self'resolvedAt, $self'finalPriceE9, $self'totalYes, $self'totalNo, $self'positions)~$TonForecastMarket$_fun_calculatePayout($Position$_tensor_cast($Position$_not_null($position)));
        throw_unless(24830, ($payout > 0));
        var ($updatedPosition'yesStake, $updatedPosition'noStake, $updatedPosition'claimed) = $Position$_not_null($position);
        $updatedPosition'claimed = true;
        $self'positions~__tact_dict_set_uint_cell(256, $positionKey, $Position$_store_cell(($updatedPosition'yesStake, $updatedPosition'noStake, $updatedPosition'claimed), begin_cell()));
        if (($self'status == 4)) {
            $global_send($SendParameters$_constructor_to_value_mode(__tact_context_get_sender(), $payout, 2));
            $TonForecastMarket$_contract_store(($self'owner, $self'resolver, $self'treasury, $self'token, $self'tokenSymbol, $self'marketId, $self'marketTitle, $self'timeframeId, $self'timeframeSeconds, $self'thresholdBps, $self'referencePriceE9, $self'protocolFeeBps, $self'createdAt, $self'closeTime, $self'status, $self'resolvedAt, $self'finalPriceE9, $self'totalYes, $self'totalNo, $self'positions));
            return ();
        }
        int $winningStake = (($self'status == 2) ? $Position$_get_yesStake($Position$_not_null($position)) : $Position$_get_noStake($Position$_not_null($position)));
        int $winnerPool = (($self'status == 2) ? $self'totalYes : $self'totalNo);
        int $loserPool = (($self'status == 2) ? $self'totalNo : $self'totalYes);
        int $grossProfit = (($winningStake * $loserPool) / $winnerPool);
        int $protocolFee = (($grossProfit * $self'protocolFeeBps) / 10000);
        if (($protocolFee > 0)) {
            $global_send($SendParameters$_constructor_to_value_mode($self'treasury, $protocolFee, 2));
        }
        $global_send($SendParameters$_constructor_to_value_mode(__tact_context_get_sender(), $payout, 2));
        $TonForecastMarket$_contract_store(($self'owner, $self'resolver, $self'treasury, $self'token, $self'tokenSymbol, $self'marketId, $self'marketTitle, $self'timeframeId, $self'timeframeSeconds, $self'thresholdBps, $self'referencePriceE9, $self'protocolFeeBps, $self'createdAt, $self'closeTime, $self'status, $self'resolvedAt, $self'finalPriceE9, $self'totalYes, $self'totalNo, $self'positions));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $TonForecastMarket$_contract_store(($self'owner, $self'resolver, $self'treasury, $self'token, $self'tokenSymbol, $self'marketId, $self'marketTitle, $self'timeframeId, $self'timeframeSeconds, $self'thresholdBps, $self'referencePriceE9, $self'protocolFeeBps, $self'createdAt, $self'closeTime, $self'status, $self'resolvedAt, $self'finalPriceE9, $self'totalYes, $self'totalNo, $self'positions));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}


() __tact_selector_hack_asm() impure asm """
@atend @ 1 {
        execute current@ context@ current!
        {
            // The core idea of this function is to save gas by avoiding unnecessary dict jump, when recv_internal/recv_external is called
            // We want to extract recv_internal/recv_external from the dict and select needed function
            // not by jumping to the needed function by it's index, but by using usual IF statements.

            }END> b> // Close previous builder, now we have a cell of previous code on top of the stack

            <{ // Start of the new code builder
                SETCP0
                // Swap the new code builder with the previous code, now we have previous code on top of the stack
                swap
                // Transform cell to slice and load first ref from the previous code, now we have the dict on top of the stack
                <s ref@

                // Extract the recv_internal from the dict
                dup 0 swap @procdictkeylen idict@ { "internal shortcut error" abort } ifnot
                swap

                // Delete the recv_internal from the dict
                0 swap @procdictkeylen idict- drop
                // Delete the recv_external from the dict (it's okay if it's not there)
                -1 swap @procdictkeylen idict- drop
                // Delete the __tact_selector_hack from the dict
                65535 swap @procdictkeylen idict- drop

                // Bring the code builder from the bottom of the stack
                // because if recv_external extraction is optional, and the number of elements on the stack is not fixed
                depth 1- roll
                // Swap with the dict from which we extracted recv_internal and (maybe) recv_external
                swap

                // Check if the dict is empty
                dup null?
                // Store a copy of this flag in the bottom of the stack
                dup depth 1- -roll
                {
                    // If the dict is empty, just drop it (it will be null if it's empty)
                    drop
                }
                {
                    // If the dict is not empty, prepare continuation to be stored in c3
                    <{
                        // Save this dict as first ref in this continuation, it will be pushed in runtime by DICTPUSHCONST
                        swap @procdictkeylen DICTPUSHCONST
                        // Jump to the needed function by it's index
                        DICTIGETJMPZ
                        // If such key is not found, throw 11 along with the key as an argument
                        11 THROWARG
                    }> PUSHCONT
                    // Store the continuation in c3
                    c3 POP
                } cond

                // Function id is on top of the (runtime) stack
                DUP IFNOTJMP:<{
                    // place recv_internal here
                    DROP swap @addop
                }>

                // Bring back the flag, indicating if the dict is empty or not from the bottom of the stack
                depth 1- roll
                {
                    // If the dict is empty, throw 11
                    11 THROWARG
                }
                {
                    // If the dict is not empty, jump to continuation from c3
                    c3 PUSH JMPX
                } cond
            }> b>
        } : }END>c
        current@ context! current!
    } does @atend !
""";

() __tact_selector_hack() method_id(65535) {
    return __tact_selector_hack_asm();
}