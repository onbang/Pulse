{
  "name": "ston-pulse-workspace",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "cleanup": "rm -rf .turbo node_modules ./{examples,packages}/**/{.next,.turbo,node_modules,dist}",
    "lint": "biome lint ./*",
    "format": "biome format ./*",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo dev --filter=@ston-fi/sdk-example-next-js-app...",
    "ci:web": "pnpm --filter @ston-fi/sdk-example-next-js-app lint:tsc && pnpm --filter @ston-fi/sdk-example-next-js-app exec next build --webpack",
    "ci:bot": "pnpm --filter @ston-pulse/telegram-bot build",
    "ci": "pnpm lint && pnpm ci:web && pnpm ci:bot"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "lefthook": "2.1.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
