{
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @ston-fi/sdk-example-next-js-app exec next build --webpack",
  "outputDirectory": "examples/next-js-app/.next",
  "functions": {
    "examples/next-js-app/app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
