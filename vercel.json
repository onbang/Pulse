{
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter=@ston-fi/sdk-example-next-js-app",
  "outputDirectory": ".next",
  "functions": {
    "app/api/forecast-markets/auto-cycle/route.ts": {
      "maxDuration": 60
    },
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
